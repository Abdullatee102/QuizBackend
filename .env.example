# Server Configuration
# =====================================================
# QuizBackend - Production Environment Configuration Template
# =====================================================
# NOTE: Use empty placeholders for secrets. NEVER put real credentials in this file.

# Environment & Server
NODE_ENV=production
PORT=5000

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
# Database Connection (PostgreSQL / Neon)
DATABASE_URL=

# Brevo Transactional Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
MAIL_FROM_EMAIL=your_verified_sender_email@domain.com
MAIL_FROM_NAME=QuizApp
# Security & Authentication (Required: Must not use fallback keys)
JWT_SECRET=
REFRESH_SECRET=

# Database Connection (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Brevo Transactional Email (Required for OTP & Password Reset)
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
OTP_EXPIRES_MINUTES=10

# Google Gemini AI Configuration
# Google OAuth Authentication (Optional / Mobile Google Sign-In)
GOOGLE_WEB_CLIENT_ID=

# Push Notifications (Optional / Expo Push Notification Service)
EXPO_ACCESS_TOKEN=

# Google Gemini AI Integration (Optional / Theory Grading & Student Support)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=15000

# CORS Configuration (Optional: Comma-separated allowed origins, or * for all)
CORS_ORIGIN=
